# Locally generated values (operator creates these; do not commit the real .env).
# Copy this file to .env and replace placeholders.

# Public origin used by browsers, recovery links, Stripe return URLs, and
# instance SEO (canonical, Open Graph, robots.txt, sitemap). Caddy, not :3000/:8080.
# Passed to the web container at runtime (not baked into the Next image).
PUBLIC_APP_URL=http://localhost

# Caddy reverse proxy. Local default is HTTP on port 80 for any Host.
# Production: CADDY_SITE=your.domain.example (no http://) so Caddy can obtain a certificate
# after DNS points at the VPS and 80/443 are open. The project does not provision DNS.
CADDY_SITE=http://:80
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# Next.js web (local debug bind). On a VPS use docker-compose.prod.yml instead of
# leaving these ports published. Compose also sets SERVER_ORIGIN=http://server:8080
# so the web container can fetch /api for metadata and sitemap (do not set that
# in this file if you also run `bun run dev` on the host).
WEB_PORT=3000
NEXT_PUBLIC_SERVER_URL=http://localhost/api

# Go API (local debug bind; public path is /api on Caddy)
SERVER_PORT=8080

# PostgreSQL 18 — locally generated password. Compose hostname is postgres.
# On the host (go run), use localhost:5432 instead of postgres.
POSTGRES_USER=hotly
POSTGRES_PASSWORD=changeme
POSTGRES_DB=hotly
POSTGRES_PORT=5432
TZ=UTC
DATABASE_URL=postgres://hotly:changeme@postgres:5432/hotly?sslmode=disable
MEDIA_PATH=/var/lib/hotly/media

# Garage (S3-compatible, Compose-internal). Regenerated with:
#   openssl rand -hex 32
# Access key format: GK + 32 hex chars. S3 port is not published; the API uses garage:3900.
GARAGE_RPC_SECRET=163e27aac542a7758542ee7610780425cb1960d07e366462f6826a866aae5475
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_BUCKET=hotly
S3_ACCESS_KEY=GKc0ffee00000000000000000000000001
S3_SECRET_KEY=b4826bc623276d6f568943497459617c2e7f9af4385e6c92de7b215d87d1e590

# Compose runs db/migrations via migrate/migrate before the API starts.
# Recreate the migrate service after adding files: docker compose up --force-recreate migrate

# Singleton creator (operator-configured verified email; not a signup form).
CREATOR_EMAIL=creator@example.com
CREATOR_DISPLAY_NAME=Creator
SUPPORT_ITEM=coffee
ONE_TIME_PRICE_CENTS=500
ONE_TIME_CHARACTER_LIMIT=250
WEEKLY_PRICE_CENTS=1500
WEEKLY_ALLOWANCE_CHARS=2000

# Locally generated secrets. Replace before any real deployment (openssl rand -base64 32).
SESSION_SECRET=local-dev-only-change-me-32bytes!
RECOVERY_TOKEN_SECRET=local-dev-only-change-me-32bytes!

# Operator-owned Firebase (leave empty until Google sign-in is enabled).
# Web config is public via GET /api/auth/config. Admin credentials stay on the API.
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_CREDENTIALS_JSON=
# Or mount a file readable by the API container user (`hotly`): chmod 644 if root-owned, then FIREBASE_CREDENTIALS_JSON=/run/secrets/firebase.json

# Operator-owned Stripe (leave empty until Checkout is wired).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Operator-owned SendGrid (leave empty until email is wired).
# API key must come from app.sendgrid.com/settings/api_keys and start with SG.
# (Not a Twilio Account SID, Auth Token, or SK… + client secret.)
# FROM_EMAIL must be a verified single sender or a mailbox on a verified domain.
# All three must be set or recovery/notices stay off. Recreate `server` after filling.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=
